{
  "name": "ecommerce-server",
  "version": "1.0.0",
  "description": "Node.js + Express API for ecommerce app",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "db:schema": "node src/scripts/runSql.js src/db/schema.sql",
    "db:seed": "node src/scripts/runSql.js src/db/seed.sql"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
